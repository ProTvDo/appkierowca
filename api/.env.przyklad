# Wzorzec konfiguracji backendu. Skopiuj jako .env i uzupełnij wartości.
# Prawdziwy .env nigdy nie trafia do repozytorium.

# ── Baza danych ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kierowcaapp
DB_USER=kierowcaapp_user
DB_PASSWORD=

# ── Aplikacja ──
PORT=3001
JWT_SECRET=

# Adresy, z których przeglądarka może wołać API bezpośrednio (po przecinku).
# Na produkcji frontend chodzi po tym samym origin przez nginx, więc lista
# jest potrzebna tylko dla wejścia wprost na api.appkierowca.pl.
CORS_ORIGINS=https://app.appkierowca.pl

# ── Poczta ──
# Bez tych wartości aplikacja działa, ale nie wyśle biuru podsumowania
# zakończonego wyjazdu ani zgłoszenia usterki. Nazwy muszą być dokładnie
# takie — kod czyta SMTP_PASS, nie SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Adresat podsumowań wyjazdów (biuro) i zgłoszeń usterek (warsztat).
# Gdy puste, używany jest SMTP_USER.
EMAIL_BIURO=
EMAIL_MISTRZ=
