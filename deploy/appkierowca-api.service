[Unit]
Description=AppKierowca API (Express + PostgreSQL)
Documentation=https://github.com/ProTvDo/appkierowca
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/kierowca-api
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5

# Konfiguracja idzie z .env w WorkingDirectory — czyta ją dotenv w server.js,
# dlatego nie ma tu EnvironmentFile (systemd parsuje ten format inaczej).
Environment=NODE_ENV=production

# Backend nie potrzebuje zapisu poza swoim katalogiem ani dostępu do /home
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/kierowca-api
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=appkierowca-api

[Install]
WantedBy=multi-user.target
